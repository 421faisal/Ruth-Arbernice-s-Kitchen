# Copy this file to .env and fill in real values. Never commit .env.
DATABASE_URL="file:./dev.db"
# Password the owner uses at /admin. Choose a strong one.
ADMIN_PASSWORD="choose-a-strong-password"
# Long random string used to sign the admin login cookie (at least 32 characters)
SESSION_SECRET="replace-with-a-long-random-string"
# Public web address, used for canonical URLs, sitemap and structured data
SITE_URL="http://localhost:3000"
# Optional: set on Vercel to store uploaded photos in Vercel Blob instead of the local uploads/ folder
# BLOB_READ_WRITE_TOKEN=""
